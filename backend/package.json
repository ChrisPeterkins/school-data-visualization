{
  "name": "@pa-school-data/backend",
  "version": "1.0.0",
  "description": "Backend API for PA School Data Visualization",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "data:import": "tsx src/scripts/importData.ts",
    "data:verify": "tsx src/scripts/verify-data.ts",
    "data:import-year": "tsx src/scripts/importYear.ts",
    "data:check-releases": "tsx src/scripts/checkPdeReleases.ts",
    "data:metadata": "tsx src/scripts/importSchoolMetadata.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/multer": "^2.0.0",
    "axios": "^1.6.2",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "multer": "^2.0.2",
    "pino": "^8.17.1",
    "pino-pretty": "^10.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  }
}
